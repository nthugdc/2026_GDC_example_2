--- !u!114 &364588755
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 364588753}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 844bf6706f476abe3ab1cb0129e32fc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideBoard
  content: "\u7B2C 5 \u7AE0 \xB7 2D \u9AA8\u9ABC\u52D5\u756B\u8207 IK\n1. \u9078
    Art/Characters/RigHero\uFF0C\u6309 Open\n   Sprite Editor\uFF0C\u5DE6\u4E0A\u89D2\u5207\u5230
    Skinning Editor\n2. Create Bone\uFF1A\u5F9E\u5C41\u80A1\u5F80\u4E0A\u9EDE\u51FA\u8EAB\u9AD4\u3001\u982D\uFF1B\n  
    \u518D\u5F9E\u80A9\u8180\u9EDE\u51FA\u624B\u81C2\uFF08\u4E0A\u81C2\u3001\u524D\u81C2\u3001\u624B\uFF09\n3.
    Auto Geometry > Generate\n   Auto Weights > Generate > Apply\n4. \u9078\u5834\u666F\u7684
    RigHero\uFF0CAdd Component\uFF1A\n   Sprite Skin > \u6309 Create Bones\n5. Animation
    \u8996\u7A97\u9304\u4E00\u6BB5 Idle\uFF08\u8F49\u52D5\u9AA8\u982D\uFF09\n6. RigHero
    \u52A0 IK Manager 2D > + > Limb\n   Effector \u9078\u624B\u7684\u9AA8\u982D\uFF0CTarget
    \u9078 HandTarget\n7. \u5B8C\u6210 Ch5_MouseTarget.cs\uFF0C\u7528\u624B\u78B0\u661F\u661F\uFF01"
  textColor: {r: 0.9607843, g: 0.96862745, b: 0.98039216, a: 1}
  fontSize: 2.185
