--- !u!114 &1710337991
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1710337989}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 844bf6706f476abe3ab1cb0129e32fc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GuideBoard
  content: "\u7B2C 6 \u7AE0 \xB7 \u81EA\u7531\u5275\u4F5C\n\u7528\u5B78\u5230\u7684\u6771\u897F\uFF0C\u505A\u4E00\u500B\u81EA\u5DF1\u7684\u95DC\u5361\uFF01\n\u5FC5\u505A\uFF1A\n1.
    \u7528 Palette_All \u756B\u51FA\u5F9E\u8D77\u9EDE\u5230\u7D42\u9EDE\u7684\u8DEF\n  
    \uFF08Ground \u6709\u78B0\u649E\uFF1B\u5CA9\u6F3F\u756B\u5728 Hazard\uFF09\n2.
    \u65B0\u589E\u8173\u672C Ch6_Footstep\uFF0C\u5BEB\u4E00\u500B\n   public void
    Footstep()\uFF0C\u5728\u8173\u908A\u5192\u7159\n   \uFF08GDCFx.Puff \u5DF2\u7D93\u5BEB\u597D\uFF0C\u53EF\u4EE5\u76F4\u63A5\u7528\uFF09\n3.
    \u6253\u958B Animations/Ch6/Hero_Run_Ch6\uFF0C\u5728\u8173\n   \u8457\u5730\u7684\u683C\u5B50\u52A0
    Animation Event \u547C\u53EB\u5B83\n\u52A0\u5206\uFF1A\u81EA\u5DF1\u505A\u4E00\u7D44
    Rule Tile\u3001\u52A0\u51B0\u3001\u6316\u78DA\u2026"
  textColor: {r: 0.9607843, g: 0.96862745, b: 0.98039216, a: 1}
  fontSize: 2.3333333
